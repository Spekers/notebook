0.jpeg","image":"https://media.ntslive.co.uk/resize/800x800/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","image_medium":"https://media.ntslive.co.uk/resize/400x400/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","thumbnail":"https://media.ntslive.co.uk/resize/100x100/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","brandTitle":null,"timeslot_html":"","frequency":"","facebook":"","twitter":"","instagram":"","soundcloud":"","website":"","website_text":"","path":null,"sanitisedTitle":"","isRepeat":false},"twoNext":{"title":"","channelId":"nts2","description":"","description_html":"","location":"","background_large":"https://media.ntslive.co.uk/resize/1600x1600/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","background_thumb":"https://media.ntslive.co.uk/resize/100x100/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","image":"https://media.ntslive.co.uk/resize/800x800/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","image_medium":"https://media.ntslive.co.uk/resize/400x400/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","thumbnail":"https://media.ntslive.co.uk/resize/100x100/f49502d8-3dcd-4785-bbfc-a104dec1ff42_1744848000.jpeg","brandTitle":null,"timeslot_html":"","frequency":"","facebook":"","twitter":"","instagram":"","soundcloud":"","website":"","website_text":"","path":null,"sanitisedTitle":"","isRepeat":false}},"radioLandingShows":{},"viewportType":"","footerPlayer":{"isOpen":false,"isExpanded":false},"networkStatus":{"networkIsOnline":true},"exploreGenre":null,"genres":{"isLoading":false,"list":[]},"moods":[],"sheet":{"displaySheet":false,"article":null,"sheetItems":[],"title":"","callback":null,"showsSortBy":"Recently Followed","undoCallback":null},"show":{},"videoPlayer":{"displayVideoPlayer":false},"episode":{"status":"published","updated":"2026-01-16T13:06:18+00:00","name":"NTS Guide to: Czech Tearoom Ambient","description":"Tearooms in post-revolution Czechoslovakia symbolised places through which new spiritualities were flowing, and the influx of largely uncharted ways of life closely intertwined with new age, ambient, folk and minimalism. With their minds altered thanks to smuggled records by Fripp & Eno or Steve Reich, this loose network of musicians had begun composing meditative music, using loops and handmade instruments, with a different sensibility. Compared to the boisterous Zappa-adjacent and booze-soaked underground movement, which was led by Plastic People of the Universe and provoked the state authorities, this music was meant instead for tea rooms and spiritual sites like churches or monasteries, as if occupying some place where time flows anticlockwise. Music journalist Pavel Klusák dubbed this 1990s scene a “tearoom alternative”. Experimental folk singer Oldřich Janota, Jaroslav Kořán’s various ensembles like Modrá or Orloj Snivců (The Horologe of Dreamers) or Irena and Vojtěch Havlovi were drawn by the light and composed music that didn’t match the fast pace of newly imported capitalism.\nMix created by: Miloš Hroch","description_html":"<h3>Tearooms in post-revolution Czechoslovakia symbolised places through which new spiritualities were flowing, and the influx of largely uncharted ways of life closely intertwined with new age, ambient, folk and minimalism. With their minds altered thanks to smuggled records by Fripp & Eno or Steve Reich, this loose network of musicians had begun composing meditative music, using loops and handmade instruments, with a different sensibility. Compared to the boisterous Zappa-adjacent and booze-soaked underground movement, which was led by Plastic People of the Universe and provoked the state authorities, this music was meant instead for tea rooms and spiritual sites like churches or monasteries, as if occupying some place where time flows anticlockwise. Music journalist Pavel Klusák dubbed this 1990s scene a “tearoom alternative”. Experimental folk singer Oldřich Janota, Jaroslav Kořán’s various ensembles like Modrá or Orloj Snivců (The Horologe of Dreamers) or Irena and Vojtěch Havlovi were drawn by the light and composed music that didn’t match the fast pace of newly imported capitalism.</h3>\n<p>Mix created by: Miloš Hroch</p>","external_links":[],"moods":[{"id":"moods-no-talkin","value":"No Talkin"},{"id":"moods-audio-research","value":"AUDIO RESEARCH"}],"genres":[{"id":"genres-rock-folk","value":"Folk"},{"id":"genres-ambientnewage-ambient","value":"Ambient"},{"id":"genres-classicalopera-minimalism","value":"Minimalism"},{"id":"genres-ambientnewage-newage","value":"New Age"}],"location_short":"LDN","location_long":"Prague","intensity":"50","media":{"background_large":"https://media2.ntslive.co.uk/resize/1600x1600/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","background_medium_large":"https://media2.ntslive.co.uk/resize/800x800/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","background_medium":"https://media.ntslive.co.uk/resize/400x400/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","background_small":"https://media3.ntslive.co.uk/resize/200x200/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","background_thumb":"https://media3.ntslive.co.uk/resize/100x100/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","picture_large":"https://media2.ntslive.co.uk/resize/1600x1600/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","picture_medium_large":"https://media2.ntslive.co.uk/resize/800x800/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","picture_medium":"https://media.ntslive.co.uk/resize/400x400/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","picture_small":"https://media3.ntslive.co.uk/resize/200x200/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png","picture_thumb":"https://media3.ntslive.co.uk/resize/100x100/447012b0-30c5-49a7-9863-46e8a7962a99_1750032000.png"},"episode_alias":"the-nts-guide-to-tearoom-ambient-16th-june-2025","show_alias":"the-nts-guide-to","broadcast":"2025-06-16T15:00:00+00:00","mixcloud":"https://www.mixcloud.com/NTSRadio/nts-