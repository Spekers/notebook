.related-ctr {
  /* vertically & horizontally center */
  position: relative;
  height: 100%;
  width: 100%;
}
.related-ctr > * {
  /* vertically & horizontally center */
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  text-align: center;
}

.related-donate-logo {
  grid-column-start: 1;
  grid-column-end: 1;
  grid-row-start: 1;
  grid-row-end: 3;
}
.related-donate-logo img {
  box-shadow: 1px 1px 3px #777;
  height: auto;
  width: auto;
  max-width: 100%;
  max-height: 100%;
  display: inline-block;
  padding: 2px;
  background-color: white;
  border: 1px solid #333;
  border-radius: 50%;
}

.related-donate-msg {
  grid-column-start: 2;
  grid-column-end: 4;
  grid-row-start: 1;
  grid-row-end: 3;
  color: #2c2c2c;
  line-height: 1.4;
  font-size: 17px;
  font-weight: bold;
  text-shadow: 1px 1px 2px gray;
}

.related-donate-btn {
  grid-column-start: 1;
  grid-column-end: 4;
  grid-row-start: 3;
  grid-row-end: 4;
  color: #fff;
  font-size: 26px;
  background-color: #31a481;
  border: 2px solid #92f5d7;
  border-radius: 4px;
  box-shadow: 1px 1px 2px gray;
}

@media (max-width: 767px) {
  #related-items {
