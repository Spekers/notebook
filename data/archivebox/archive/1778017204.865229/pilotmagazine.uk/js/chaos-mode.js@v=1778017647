        });

        // Measure both panels to get full content height
        const getMobilePanelHeight = async (panel) => {
            return new Promise((resolve) => {
                setTimeout(() => {
                    requestAnimationFrame(() => {
                        const original = {
                            overflow: panel.style.overflow,
                            display: panel.style.display,
                            visibility: panel.style.visibility,
                            position: panel.style.position,
                            top: panel.style.top,
                            left: panel.style.left,
                            width: panel.style.width,
                            height: panel.style.height,
                            zIndex: panel.style.zIndex
                        };
                        
                        // Temporarily make panel visible to measure
                        panel.style.overflow = 'auto';
                        panel.style.display = 'block';
                        panel.style.visibility = 'visible';
                        panel.style.position = 'absolute';
                        panel.style.top = '-9999px';
                        panel.style.left = '0';
                        panel.style.width = '100%';
                        panel.style.height = 'auto';
                        panel.style.zIndex = '-1';

                        panel.offsetHeight; // Force reflow

                        const base = Math.max(panel.scrollHeight, panel.offsetHeight, panel.clientHeight);
                        let maxBottom = base;
                        const panelRect = panel.getBoundingClientRect();
                        const st = panel.scrollTop;
                        
                        // Scan children for max height
                        panel.querySelectorAll('*').forEach(el => {
                            const style = getComputedStyle(el);
                            if (style.position === 'fixed') return;
                            const r = el.getBoundingClientRect();
                            if (r.height <= 0) return;
                            const bottom = (r.bottom - panelRect.top) + st;
                            if (bottom > 0) maxBottom = Math.max(maxBottom, bottom);
                        });

                        // Restore original styles
                        panel.style.overflow = original.overflow;
                        panel.style.display = original.display;
                        panel.style.visibility = original.visibility;
                        panel.style.position = original.position;
                        panel.style.top = original.top;
                        panel.style.left = original.left;
                        panel.style.width = original.width;
                        panel.style.height = original.height;
                        panel.style.zIndex = original.zIndex;

                        resolve(Math.max(maxBottom, window.innerHeight));
                    });
                }, 50);
            });
        };

        // Measure both panels and use the maximum
