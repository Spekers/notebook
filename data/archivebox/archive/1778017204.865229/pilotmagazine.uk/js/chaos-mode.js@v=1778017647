                    el.remove();
                } else {
                    console.log('🧹 Keeping canvas overlay:', el.id);
                }
            });
            container.querySelectorAll('.chaos-element, .chaos-element-text').forEach(el => el.remove());

            // Render all elements
            finalElements.forEach(item => {
                if (item.type === 'comment') {
                    const comment = item.data;
                    
                    const el = document.createElement('div');
                    el.className = 'chaos-element-text';
                    el.textContent = comment.comment;

                    // Variable sizing for desktop - some bigger, some same as before
                    let fontSize, maxWidth;
                    
                    if (isMobile) {
                        fontSize = '16px';
                        maxWidth = '180px';
                    } else {
                        // Desktop: Create variety in comment sizes
                        // Use comment ID or content hash to determine size consistently
                        const commentHash = this.hashString(comment.comment + (comment.id || ''));
                        const sizeVariant = commentHash % 3; // 0, 1, or 2
                        
                        switch (sizeVariant) {
                            case 0: // Bigger size
                                fontSize = '45px';
                                maxWidth = '500px';
                                break;
                            case 1: // Medium size (current)
                                fontSize = '30px';
                                maxWidth = '400px';
                                break;
                            case 2: // Smaller size
                                fontSize = '24px';
                                maxWidth = '350px';
                                break;
                        }
