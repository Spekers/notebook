    async placeSticker(e) {
        if (!this.selectedSticker) return;

        const container = this.chaosContainer || document.querySelector('.chaos-container');
        const isMobile = window.innerWidth < 1024;
        const rect = this.chaosViewport ? this.chaosViewport.getBoundingClientRect() : this.activePanel.getBoundingClientRect();
        const scrollTop = this.scrollableContainer ? this.scrollableContainer.scrollTop : 0;

        // Click position relative to the viewport/panel
        const clickX = e.clientX - rect.left;
        const clickY = (e.clientY - rect.top) + scrollTop;

        // Mobile: Use viewport height only for natural placement
        // Desktop: Use full content height for scrollable canvas
        const containerHeight = isMobile ? window.innerHeight : this.contentHeight;
        const containerWidth = rect.width;
        const xPercent = (clickX / containerWidth) * 100;
        const yPercent = (clickY / containerHeight) * 100;

        console.log('🎨 PlaceSticker position:', {
            isMobile,
            clickPos: { x: e.clientX, y: e.clientY },
            rect: { left: rect.left, top: rect.top, width: rect.width },
            clickRelative: { x: clickX, y: clickY },
            containerHeight,
            percent: { x: xPercent, y: yPercent }
        });

        try {
            const response = await fetch('/chaos/sticker', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf"]').content
                },
                body: JSON.stringify({
                    sticker: this.selectedSticker,
                    x_position: xPercent,
                    y_position: yPercent,
                    page_url: window.location.pathname,
                    article_id: this.getArticleId(),
                    placed_on_mobile: isMobile
                })
            });

            if (response.ok) {
                const data = await response.json();
                // Add to undo stack
                if (data.id) {
                    this.undoStack.push({ type: 'sticker', id: data.id });
                    this.updateUndoButton();
                }
                await this.loadExistingElements();
            }

            this.selectedSticker = null;

        } catch (error) {
            console.error('Failed to place sticker:', error);
        }
    }

    cleanupStickerMode() {
        // Remove sticker click handler from canvas
        if (this.stickerClickHandler && this.hitLayer) {
            this.hitLayer.removeEventListener('click', this.stickerClickHandler);
        }

        const selector = document.getElementById('sticker-selector');
        if (selector) selector.remove();

        this.selectedSticker = null;
        this.stickerClickHandler = null;
        
        // Reset canvas cursor and pointer events
        if (this.hitLayer) {
            this.hitLayer.style.cursor = 'default';
            this.hitLayer.style.pointerEvents = 'none';
        }
    }

    removePanelEffects() {
        const isMobile = window.innerWidth < 1024;

        if (isMobile) {
            if (this.chaosOverlay) {
                try {
                    ['click','mousedown','mouseup','pointerdown','pointerup','dblclick','contextmenu'].forEach(evt => {
                        this.chaosOverlay.removeEventListener(evt, this.overlayPointerBlocker);
                    });
                    this.chaosOverlay.removeEventListener('touchstart', this.overlayTouchStartHandler);
                    this.chaosOverlay.removeEventListener('touchmove', this.overlayTouchMoveHandler);
                } catch (_) { }
                this.chaosOverlay.remove();
                this.chaosOverlay = null;
            }

            if (this.chaosContainer) { this.chaosContainer.remove(); this.chaosContainer = null; }
            if (this.chaosViewport) {
                // Mobile viewport is also on body
                if (document.body.contains(this.chaosViewport)) {
                    this.chaosViewport.remove();
                }
                this.chaosViewport = null;
            }

            if (this.activePanel) this.activePanel.classList.remove('chaos-active-panel');

            if (this.resizeObserver) { this.resizeObserver.disconnect(); this.resizeObserver = null; }
            if (this.mutationObserver) { this.mutationObserver.disconnect(); this.mutationObserver = null; }

            if (this.scrollHandler && this.scrollableContainer) {
                this.scrollableContainer.removeEventListener('scroll', this.scrollHandler);
            }
            this.scrollHandler = null;

            if (this._repositionHandlers) {
                this._repositionHandlers.forEach(([evt, fn]) => window.removeEventListener(evt, fn));
                this._repositionHandlers = null;
            }

            if (this.originalOpenRightSide !== undefined) {
                const alpineApp = document.querySelector('[x-data]');
                if (alpineApp && alpineApp._x_dataStack && alpineApp._x_dataStack[0]) {
                    const alpineData = alpineApp._x_dataStack[0];
                    alpineData.openRightSide = this.originalOpenRightSide;
                }
            }

            if (this.originalLocalStorageRightSide !== undefined) {
                localStorage.setItem('openRightSide', this.originalLocalStorageRightSide);
            }

            this.activePanel = null;
            this.contentPanel = null;
            this.scrollableContainer = null;

            this.unlockBodyScroll();
            return;
        }

        // Desktop cleanup
        const leftPanel = document.getElementById('leftSideContent') || document.getElementById('leftSideContentMobile');
        const rightPanel = document.getElementById('rightSide') || document.getElementById('rightSideMobile');

        if (leftPanel) {
            leftPanel.style.overflow = this.originalLeftOverflow || '';
            leftPanel.style.height = this.originalLeftHeight || '';
            if (this.originalLeftPosition !== undefined) leftPanel.style.position = this.originalLeftPosition;
            if (this.originalLeftTop !== undefined) leftPanel.style.top = this.originalLeftTop;
        }
        if (rightPanel) {
            rightPanel.style.overflow = this.originalRightOverflow || '';
            rightPanel.style.height = this.originalRightHeight || '';
            if (this.originalRightPosition !== undefined) rightPanel.style.position = this.originalRightPosition;
            if (this.originalRightTop !== undefined) rightPanel.style.top = this.originalRightTop;
        }

        if (this.originalTargetChildrenOverflow && this.activePanel) {
            const targetScrollableChildren = this.activePanel.querySelectorAll('[class*="overflow-auto"], [class*="overflow-y-auto"], [class*="overflow-x-auto"]');
            targetScrollableChildren?.forEach((child, index) => {
                if (this.originalTargetChildrenOverflow[index] !== undefined) {
                    child.style.overflow = this.originalTargetChildrenOverflow[index];
                }
                // Restore scroll position
                if (this.originalTargetChildrenScrollTop && this.originalTargetChildrenScrollTop[index] !== undefined) {
                    child.scrollTop = this.originalTargetChildrenScrollTop[index];
                }
            });
        }

        if (this.contentPanel) {
            if (this.originalReadableOverscroll !== undefined) this.contentPanel.style.overscrollBehavior = this.originalReadableOverscroll;
            if (this.originalReadableWebkitScroll !== undefined) this.contentPanel.style.webkitOverflowScrolling = this.originalReadableWebkitScroll;
        }

        if (this.chaosOverlay) {
            try {
                ['click','mousedown','mouseup','pointerdown','pointerup','dblclick','contextmenu'].forEach(evt => {
                    this.chaosOverlay.removeEventListener(evt, this.overlayPointerBlocker);
                });
                this.chaosOverlay.removeEventListener('wheel', this.overlayWheelHandler);
                this.chaosOverlay.removeEventListener('touchstart', this.overlayTouchStartHandler);
                this.chaosOverlay.removeEventListener('touchmove', this.overlayTouchMoveHandler);
            } catch (_) { }
            this.chaosOverlay.remove();
            this.chaosOverlay = null;
        }

        if (this.chaosContainer) { this.chaosContainer.remove(); this.chaosContainer = null; }
        if (this.chaosViewport) {
            // Remove from body for desktop (was appended to body)
            if (document.body.contains(this.chaosViewport)) {
                this.chaosViewport.remove();
            }
            this.chaosViewport = null;
        }

        if (this.resizeObserver) { this.resizeObserver.disconnect(); this.resizeObserver = null; }
        if (this.mutationObserver) { this.mutationObserver.disconnect(); this.mutationObserver = null; }

        if (this.scrollHandler && this.scrollableContainer) {
            this.scrollableContainer.removeEventListener('scroll', this.scrollHandler);
            window.removeEventListener('scroll', this.scrollHandler);
        }
        this.scrollHandler = null;

        if (this.viewportPositionHandler) {
            window.removeEventListener('resize', this.viewportPositionHandler);
            window.removeEventListener('scroll', this.viewportPositionHandler);
            this.viewportPositionHandler = null;
        }

        this.activePanel = null;
        this.contentPanel = null;
        this.scrollableContainer = null;

        document.querySelectorAll('.chaos-active-panel').forEach(el => {
            el.classList.remove('chaos-active-panel');
        });
    }

    lockBodyScroll() {
        if (this.bodyScrollLocked) return;
        this.bodyScrollY = window.scrollY || window.pageYOffset || 0;
        const body = document.body;
        const html = document.documentElement;
        this.originalBodyStyles = {
            position: body.style.position,
            top: body.style.top,
            width: body.style.width,
            overflow: body.style.overflow,
        };
        body.style.position = 'fixed';
        body.style.top = `-${this.bodyScrollY}px`;
        body.style.width = '100%';
        body.style.overflow = 'hidden';
        html.style.overscrollBehaviorY = 'none';
        this.bodyScrollLocked = true;
    }

    unlockBodyScroll() {
        if (!this.bodyScrollLocked) return;
        const body = document.body;
        const html = document.documentElement;
        body.style.position = this.originalBodyStyles.position || '';
        body.style.top = this.originalBodyStyles.top || '';
        body.style.width = this.originalBodyStyles.width || '';
        body.style.overflow = this.originalBodyStyles.overflow || '';
        html.style.overscrollBehaviorY = '';
        window.scrollTo(0, this.bodyScrollY || 0);
        this.bodyScrollLocked = false;
    }


