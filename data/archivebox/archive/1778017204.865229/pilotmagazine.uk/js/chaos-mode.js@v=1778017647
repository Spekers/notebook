    createSharedCanvas(contentHeight, contentPanel, panelWidth) {
        if (!this.chaosContainer) return;

        // clear old tiles/hit layer
        this.tiles.forEach(t => t.canvas.remove());
        this.tiles = [];
        if (this.hitLayer) { this.hitLayer.remove(); this.hitLayer = null; }

        const leftOffset = this.dividerWidth || 0;
        const widthAdjustment = leftOffset > 0 ? `calc(100% - ${leftOffset}px)` : '100%';
        
        const basePanelWidth =
            panelWidth ||
            this.chaosContainer.clientWidth ||
            this.chaosViewport?.clientWidth ||
            this.activePanel?.clientWidth || 320;
        
        // Adjust container width to account for divider
        const containerWidth = basePanelWidth - leftOffset;

        // Full-height hit layer for events
        this.hitLayer = document.createElement('div');
        this.hitLayer.className = 'chaos-hitlayer';
        this.hitLayer.style.cssText = `
            position:absolute;top:0;left:${leftOffset}px;width:${widthAdjustment};height:${contentHeight}px;
            pointer-events:none; /* turned on per-tool */
            z-index:10;
        `;
        this.chaosContainer.appendChild(this.hitLayer);

        // Build stacked canvas tiles
        const maxTileCss = this.getMaxCssHeightForCanvas();
        let remaining = contentHeight;
        let top = 0;

        while (remaining > 0) {
            const segCss = Math.min(remaining, maxTileCss);
            const { bitmapHeight, dpr } = this.getSafeHeights(segCss);

            const c = document.createElement('canvas');
            c.className = 'chaos-tile';
            c.style.cssText = `
                position:absolute;left:${leftOffset}px;top:${top}px;width:${widthAdjustment};height:${segCss}px;
                pointer-events:none; /* drawing happens via hitLayer */
                z-index:5;
                visibility:visible;
                opacity:1;
                display:block;
            `;
            const safeBitmapWidth = Math.min(
                Math.floor(containerWidth * dpr),
                ChaosMode.MAX_BITMAP_DIM - ChaosMode.BITMAP_MARGIN
            );
            c.width  = safeBitmapWidth;
            c.height = bitmapHeight;

            const ctx = c.getContext('2d', { alpha:true });
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            ctx.strokeStyle = this.currentColor;
            ctx.lineWidth = (window.innerWidth < 1024) ? 3 : 4;

            this.chaosContainer.appendChild(c);
            this.tiles.push({ canvas:c, ctx, top, height:segCss, dpr });

            top += segCss;
            remaining -= segCss;
        }

        // Maintain legacy fields
        this.canvas = this.tiles[0]?.canvas || null;
        this.ctx    = this.tiles[0]?.ctx    || null;

        // Ensure container has full height
        this.chaosContainer.style.height = contentHeight + 'px';
        this.contentHeight = contentHeight;

        console.log('✅ Tiled canvases created:', {
            tiles: this.tiles.map(t => ({ top:t.top, height:t.height, w:t.canvas.width, h:t.canvas.height }))
        });
    }

    async applyMobileChaosMode(leftPanel, rightPanel) {
