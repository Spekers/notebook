                    el.style.cssText = `
                        position: absolute;
                        left: ${item.x}%;
                        top: ${item.y}%;
                        transform: translate(-50%, -50%);
                        font-family: 'Times New Roman', Times, serif;
                        color: ${comment.color};
                        font-size: ${fontSize};
                        pointer-events: none;
                        z-index: 2;
                        max-width: ${maxWidth};
                        word-wrap: break-word;
                        line-height: 1.2;
                    `;
                    
                    // DEBUG: Track tttt being rendered
                    if (comment.comment === 'tttt') {
                        console.log('🎨 Rendering tttt comment:', {
                            position: { x: item.x + '%', y: item.y + '%' },
                            color: comment.color,
                            fontSize
                        });
                    }
                    
                    container.appendChild(el);
                }
                else if (item.type === 'sketch') {
                    const sketch = item.data;
                    const img = document.createElement('img');
                    img.className = 'chaos-element';
                    img.src = sketch.sketch;

                    // Moderate sizing - visible but not overwhelming
                    const maxWidth = isMobile ? '150px' : '400px';

                    img.style.cssText = `
                        position: absolute;
                        left: ${item.x}%;
                        top: ${item.y}%;
                        transform: translate(-50%, -50%);
                        width: auto;
                        max-width: ${maxWidth};
                        height: auto;
                        pointer-events: none;
                        z-index: 4;
                        opacity: 1;
                    `;
                    
                    container.appendChild(img);
                    
                    // Handle image loading
                    img.onload = () => {
                        const dpr = window.devicePixelRatio || 1;
                        const targetWidthCss = Math.max(1, Math.round(img.naturalWidth / dpr));
                        img.style.width = targetWidthCss + 'px';
                        img.style.height = 'auto';
                    };
                }
                else if (item.type === 'sticker') {
                    const sticker = item.data;
                    const img = document.createElement('img');
