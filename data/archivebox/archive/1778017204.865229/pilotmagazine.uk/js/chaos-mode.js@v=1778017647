// Chaos Mode - Interactive Drawing, Comments, and Stickers System
class ChaosMode {
    constructor() {
        this.isActive = false;
        this.isPencilOpen = false;
        this.currentTool = null;
        this.currentColor = localStorage.getItem('bgColor') || '#2D4DFF';
        this.isDrawing = false;
        this.canvas = null;
        this.ctx = null;
        this.drawingPaths = [];
        this.currentPath = [];
        this.selectedSticker = null;
        
        // Bind event handlers once
        this.boundStartDrawing = this.startDrawing.bind(this);
        this.boundDraw = this.draw.bind(this);
        this.boundStopDrawing = this.stopDrawing.bind(this);
        this.textClickHandler = null;
        this.stickerClickHandler = null;
        this.chaosOverlay = null;
        this.chaosViewport = null;
        this.chaosContainer = null;
        this.resizeObserver = null;
        this.mutationObserver = null;
        this.activePanel = null;
        this.contentPanel = null;
        this.elementsLoaded = false;
        this.scrollableContainer = null;
        this.scrollHandler = null;
        this.contentHeight = 0;
        this.bodyScrollLocked = false;
        this.bodyScrollY = 0;
        this.originalBodyStyles = {};
        this._repositionHandlers = null;
        this._panelRect = null;
        this.viewportPositionHandler = null;
        this.tiles = [];
        this.hitLayer = null;
        this.currentTileIdx = undefined;
        
        // Drawing optimization
        this.cachedRect = null;
        this.cachedScrollTop = 0;
        this.lastDrawnPoint = null;
        this.drawingScheduled = false;
        this.pendingDrawPoint = null;

        // Undo functionality
        this.undoStack = [];

        this.init();
    }

	// === Canvas safety limits (cross-browser safe) ===
	static MAX_BITMAP_DIM = 32767; // conservative cap
	static BITMAP_MARGIN = 512;    // safety headroom

	getMaxCssHeightForCanvas() {
		const dpr = window.devicePixelRatio || 1;
		// ensure bitmap (css * dpr) <= MAX_BITMAP_DIM - margin
		return Math.max(1, Math.floor((ChaosMode.MAX_BITMAP_DIM - ChaosMode.BITMAP_MARGIN) / dpr));
	}

	/** Returns clamped CSS height and bitmap height for a given raw content height */
	getSafeHeights(rawCssHeight) {
		const dpr = window.devicePixelRatio || 1;
		const maxCss = this.getMaxCssHeightForCanvas();
		const cssHeight = Math.min(Math.max(1, Math.floor(rawCssHeight)), maxCss);
		const bitmapHeight = Math.min(
			Math.floor(cssHeight * dpr),
			ChaosMode.MAX_BITMAP_DIM - ChaosMode.BITMAP_MARGIN
		);
		return { cssHeight, bitmapHeight, dpr };
	}

    _getTileIndexForY(yCss) {
        for (let i = 0; i < this.tiles.length; i++) {
            const t = this.tiles[i];
            if (yCss >= t.top && yCss < t.top + t.height) return i;
        }
        return this.tiles.length - 1;
    }

    init() {
        window.addEventListener('colorChanged', (e) => {
            this.currentColor = e.detail.color;
            if (this.ctx) {
                this.ctx.strokeStyle = this.currentColor;
            }
            this.updateAllTextColors();
        });

        this.setupMobilePanelMonitor();
    }

    setupMobilePanelMonitor() {
        const observer = new MutationObserver(() => {
            if (window.innerWidth < 1024) {
                this.handleMobilePanelToggle();
            }
        });

        const alpineApp = document.querySelector('[x-data]');
        if (alpineApp) {
            observer.observe(alpineApp, {
                attributes: true,
                attributeFilter: ['x-data', 'x-show', 'x-transition']
            });
        }

        window.addEventListener('storage', (e) => {
            if (e.key === 'openRightSide' && window.innerWidth < 1024) {
                setTimeout(() => this.handleMobilePanelToggle(), 100);
            }
        });
    }

    /**
     * Simple collision detection for mobile - push overlapping elements apart
     * Only runs on mobile, desktop unaffected
     */
    adjustMobilePositions(elements) {
        const isMobile = window.innerWidth < 1024;
        if (!isMobile || elements.length < 2) return elements;

        const adjusted = [...elements];
        const viewWidth = this.chaosViewport?.clientWidth || window.innerWidth;
        const viewHeight = this.contentHeight || window.innerHeight;

        // Multiple passes to ensure all overlaps are resolved
        const maxPasses = 5;
        for (let pass = 0; pass < maxPasses; pass++) {
            let hadCollision = false;
            
            // Pairwise check - if elements overlap significantly, nudge them apart
            for (let i = 0; i < adjusted.length; i++) {
                for (let j = i + 1; j < adjusted.length; j++) {
                    const a = adjusted[i];
                    const b = adjusted[j];

                    // Calculate centers in pixels
                    const aX = (a.x / 100) * viewWidth;
                    const aY = (a.y / 100) * viewHeight;
                    const bX = (b.x / 100) * viewWidth;
                    const bY = (b.y / 100) * viewHeight;

                    // Estimate element sizes with generous buffer
                    const aSize = a.size || 100;
                    const bSize = b.size || 100;

                    // Check if too close (within combined radius)
                    // Add 70% buffer to prevent elements from touching
                    const dx = bX - aX;
                    const dy = bY - aY;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    const minDistance = ((aSize + bSize) / 2) * 1.7; // 1.7x spacing buffer

                    if (distance < minDistance && distance > 0) {
                        hadCollision = true;
                        
                        // Push apart along the line between them (more aggressively)
                        const pushDistance = (minDistance - distance) / 2;
                        const dirX = dx / distance;
                        const dirY = dy / distance;

                        // Move both elements (more natural than moving just one)
                        const newAX = aX - dirX * pushDistance;
                        const newAY = aY - dirY * pushDistance;
                        const newBX = bX + dirX * pushDistance;
                        const newBY = bY + dirY * pushDistance;

                        // Convert back to percentages
                        a.x = (newAX / viewWidth) * 100;
                        a.y = (newAY / viewHeight) * 100;
                        b.x = (newBX / viewWidth) * 100;
                        b.y = (newBY / viewHeight) * 100;

                        // Keep within safe bounds (avoid header at top, keep centered)
                        a.x = Math.max(20, Math.min(80, a.x));
                        a.y = Math.max(22, Math.min(85, a.y)); // Increased top margin to 22%
                        b.x = Math.max(20, Math.min(80, b.x));
                        b.y = Math.max(22, Math.min(85, b.y)); // Increased top margin to 22%

                        console.log(`💥 Pass ${pass + 1}: Adjusted overlapping elements (distance: ${distance.toFixed(0)}px < ${minDistance.toFixed(0)}px)`);
                    }
                }
            }
            
            // If no collisions in this pass, we're done
            if (!hadCollision) {
                console.log(`✅ Collision resolution complete after ${pass + 1} pass(es)`);
                break;
            }
        }

        return adjusted;
    }

    /**
     * Check if a position collides with any existing elements
     * Returns true if collision detected
     */
    checkCollision(x, y, width, height, placedElements) {
        const buffer = 5; // Add 5% buffer around elements
        
        for (const element of placedElements) {
            const el = element;
            const elLeft = el.x - (el.width / 2);
            const elRight = el.x + (el.width / 2);
            const elTop = el.y - (el.height / 2);
            const elBottom = el.y + (el.height / 2);
            
            const newLeft = x - (width / 2) - buffer;
            const newRight = x + (width / 2) + buffer;
            const newTop = y - (height / 2) - buffer;
            const newBottom = y + (height / 2) + buffer;
            
            // Check if rectangles overlap
            const overlaps = !(newRight < elLeft || newLeft > elRight || newBottom < elTop || newTop > elBottom);
            
            if (overlaps) {
                return true;
            }
        }
        return false;
    }

    /**
     * Find a non-colliding position near the desired location
     */
    findNonCollidingPosition(desiredX, desiredY, width, height, placedElements, maxAttempts = 50) {
        // Try the original position first
        if (!this.checkCollision(desiredX, desiredY, width, height, placedElements)) {
            return { x: desiredX, y: desiredY };
        }
        
        // Try positions in a spiral pattern around the desired location
        for (let attempt = 1; attempt <= maxAttempts; attempt++) {
            const angle = (attempt * 137.5) * (Math.PI / 180); // Golden angle for good distribution
            const distance = attempt * 3; // Increase distance with each attempt
            
            const x = desiredX + (distance * Math.cos(angle));
            const y = desiredY + (distance * Math.sin(angle));
            
            // Keep within bounds (10-90% to avoid edges)
            if (x < 10 || x > 90 || y < 10 || y > 90) continue;
            
            if (!this.checkCollision(x, y, width, height, placedElements)) {
                console.log(`✅ Found non-colliding position after ${attempt} attempts:`, { original: { x: desiredX, y: desiredY }, final: { x, y } });
                return { x, y };
            }
        }
        
        // Fallback: return original position with warning
        console.warn('⚠️ Could not find non-colliding position after', maxAttempts, 'attempts. Using original position.');
        return { x: desiredX, y: desiredY };
    }

    /**
     * Disperse mobile-placed items across desktop page height with collision detection
     * Stickers and comments only - sketches are filtered out on desktop
     */
    disperseMobileItemsOnDesktop(item, placedElements) {
        const isMobile = window.innerWidth < 1024;
        
        // Treat as mobile-placed if:
        // 1. Explicitly marked as placed_on_mobile
        // 2. OR flag is missing/null AND Y position is in viewport range (likely mobile)
        const isMobilePlaced = item.data.placed_on_mobile || 
                               (item.data.placed_on_mobile === undefined && item.y <= 100);
        
        // Only apply on desktop for mobile-placed items
        if (isMobile || !isMobilePlaced) {
            return { x: item.x, y: item.y };
        }

        // Use item ID to create deterministic but varied placement
        const id = item.data.id;
        
        // Simple hash function to convert ID to a pseudo-random but consistent number
        const hash = (id * 2654435761) % 2147483648;
        const normalizedHash = hash / 2147483648; // 0-1
        
        // Distribute Y across the full page height (skip top 10% for header, bottom 5% for footer)
        const mobileY = item.y; // 0-100
        const sectionSize = 85 / 5; // Divide into 5 sections: 10-27%, 27-44%, 44-61%, 61-78%, 78-95%
        const section = Math.floor(normalizedHash * 5); // 0-4
        const baseY = 10 + (section * sectionSize);
        
        // Add some variance within the section based on original Y position
        const variance = (mobileY / 100) * sectionSize;
        const desiredY = baseY + variance;
        
        // Adjust X slightly to avoid clustering
        const xVariance = (normalizedHash * 10) - 5; // -5 to +5
        const newX = 50 + xVariance;
        const desiredX = Math.max(35, Math.min(65, newX));
        
        // Estimate element size (approximate)
        const elementWidth = item.type === 'comment' ? 15 : 8; // Comments wider than stickers
        const elementHeight = item.type === 'comment' ? 5 : 8;
        
        // Find non-colliding position
        const finalPosition = this.findNonCollidingPosition(
            desiredX, 
            desiredY, 
            elementWidth, 
            elementHeight, 
            placedElements
        );
        
        console.log('🌊 Dispersing mobile item with collision detection:', {
            id,
            type: item.type,
            content: item.type === 'comment' ? item.data.comment : 'N/A',
            original: { x: item.x, y: item.y },
            desired: { x: desiredX.toFixed(1), y: desiredY.toFixed(1) },
            final: { x: finalPosition.x.toFixed(1), y: finalPosition.y.toFixed(1) }
        });
        
        return finalPosition;
    }

    updateAllTextColors() {
        if (!this.isActive) return;
        const container = document.querySelector('.chaos-container');
        if (!container) return;
        container.querySelectorAll('.chaos-element-text').forEach(el => {
            el.style.color = this.currentColor;
        });
    }

    async openPencil() {
        this.isPencilOpen = true;
        this.isActive = true;

        setTimeout(async () => {
            await this.applyPanelEffects();
            this.createMobileUndoButton();
            this.showDesktopUndoButton();
            setTimeout(() => {
                this.loadExistingElements();
            }, 100);
        }, 150);
    }

    closePencil() {
        this.isPencilOpen = false;
        this.isActive = false;
        this.currentTool = null;
        this.elementsLoaded = false;

        this.cleanup();
        this.removePanelEffects();
        this.unlockBodyScroll();
        
        // Clear undo stack when closing chaos mode
        this.undoStack = [];
        this.updateUndoButton();
        
        // Hide desktop undo button
        this.hideDesktopUndoButton();
        
        // Remove mobile undo button
        const mobileUndoBtn = document.getElementById('chaos-undo-mobile');
        if (mobileUndoBtn) mobileUndoBtn.remove();
    }

    activate(tool) {
        if (!this.isPencilOpen) {
            this.openPencil();
            setTimeout(() => {
                this.currentTool = tool;
                this.setupTool(tool);
            }, 700);
            return;
        }

        if (this.currentTool === tool) {
            this.cleanupCurrentTool();
            this.currentTool = null;
            return;
        }

        if (this.currentTool) {
            this.cleanupCurrentTool();
        }

        this.currentTool = tool;
        setTimeout(() => this.setupTool(tool), 200);
    }

    setupTool(tool) {
        switch (tool) {
            case 'draw':
                this.setupDrawingMode();
                break;
            case 'text':
                this.setupTextMode();
                break;
            case 'sticker':
                this.setupStickerMode();
                break;
        }
    }

    cleanupCurrentTool() {
        switch (this.currentTool) {
            case 'draw':
                this.cleanupDrawingMode();
                break;
            case 'text':
                this.cleanupTextMode();
                break;
            case 'sticker':
                this.cleanupStickerMode();
                break;
        }
    }

    cleanup() {
        this.cleanupDrawingMode();
        this.cleanupTextMode();
        this.cleanupStickerMode();
        
        // Remove the shared canvas when chaos mode is completely closed
        if (this.canvas) {
            this.canvas.remove();
            this.canvas = null;
            this.ctx = null;
        }
    }

    async applyPanelEffects() {
        const leftPanel = document.getElementById('leftSideContent') || document.getElementById('leftSideContentMobile');
        const rightPanel = document.getElementById('rightSide') || document.getElementById('rightSideMobile');

        console.log('🎨 === CHAOS MODE DEBUG START ===');
        console.log('📍 Panel Detection:', {
            leftPanel: !!leftPanel,
            rightPanel: !!rightPanel,
            leftPanelId: leftPanel?.id,
            rightPanelId: rightPanel?.id,
            leftPanelElement: leftPanel,
            rightPanelElement: rightPanel
        });

        // Additional debugging for right panel
        if (rightPanel) {
            console.log('🔍 Right Panel Details:', {
                id: rightPanel.id,
                className: rightPanel.className,
                style: rightPanel.style.cssText,
                display: window.getComputedStyle(rightPanel).display,
                visibility: window.getComputedStyle(rightPanel).visibility,
                height: window.getComputedStyle(rightPanel).height,
                scrollHeight: rightPanel.scrollHeight,
                offsetHeight: rightPanel.offsetHeight,
                clientHeight: rightPanel.clientHeight,
                children: Array.from(rightPanel.children).map(child => ({
                    tagName: child.tagName,
                    id: child.id,
                    className: child.className,
                    display: window.getComputedStyle(child).display
                }))
            });
        } else {
            console.error('❌ Right panel not found! Available elements:', {
                rightSide: !!document.getElementById('rightSide'),
                rightSideMobile: !!document.getElementById('rightSideMobile'),
                allElementsWithRight: Array.from(document.querySelectorAll('*')).filter(el => el.id && el.id.includes('right')).map(el => el.id)
            });
        }

        if (!leftPanel || !rightPanel) {
            console.error('❌ Panels not found!');
            return;
        }

        const isArticlePage = window.location.pathname.includes('/article/');
        const isMobile = window.innerWidth < 1024;

        console.log('📱 Environment:', {
            isArticlePage,
            isMobile,
            pathname: window.location.pathname,
            windowWidth: window.innerWidth,
            windowHeight: window.innerHeight
        });

        if (isMobile) {
            await this.applyMobileChaosMode(leftPanel, rightPanel);
            return;
        }

        // ===== DESKTOP =====
        let targetPanel;
        let contentPanel;

        if (isArticlePage) {
            targetPanel = rightPanel;
            contentPanel = leftPanel;
        } else {
            targetPanel = leftPanel;
            contentPanel = rightPanel;
        }

        console.log('🎯 Panel Assignment:', {
            targetPanel: targetPanel.id,
            contentPanel: contentPanel.id,
            isRightPanel: targetPanel.id.includes('right') || targetPanel.id.includes('Right'),
            isLeftPanel: targetPanel.id.includes('left') || targetPanel.id.includes('Left')
        });
        
        // Store panel type for debugging
        this.panelType = targetPanel.id.includes('right') ? 'right' : 'left';
        console.log('🏷️ Panel Type:', this.panelType);
        
        // Debug panel differences
        console.log('🔍 Panel Comparison Debug:', {
            targetPanel: {
                id: targetPanel.id,
                rect: targetPanel.getBoundingClientRect(),
                display: window.getComputedStyle(targetPanel).display,
                visibility: window.getComputedStyle(targetPanel).visibility,
                height: window.getComputedStyle(targetPanel).height,
                overflow: window.getComputedStyle(targetPanel).overflow,
                children: Array.from(targetPanel.children).map(child => ({
                    tagName: child.tagName,
                    id: child.id,
                    className: child.className
                }))
            },
            contentPanel: {
                id: contentPanel.id,
                rect: contentPanel.getBoundingClientRect(),
                display: window.getComputedStyle(contentPanel).display,
                visibility: window.getComputedStyle(contentPanel).visibility,
                height: window.getComputedStyle(contentPanel).height,
                overflow: window.getComputedStyle(contentPanel).overflow,
                children: Array.from(contentPanel.children).map(child => ({
                    tagName: child.tagName,
                    id: child.id,
                    className: child.className
                }))
            }
        });

        this.activePanel = targetPanel;
        this.contentPanel = contentPanel;
        this.lockBodyScroll();

        const getPanelHeight = async (panel) => {
            return new Promise((resolve) => {
                setTimeout(() => {
                    requestAnimationFrame(() => {
                        const base = Math.max(panel.scrollHeight, panel.offsetHeight, panel.clientHeight);

                        // Scan descendants but ignore fixed/absolute off-screen monsters
                        const panelRect = panel.getBoundingClientRect();
                        let maxBottom = base;

                        panel.querySelectorAll('*').forEach(el => {
                            const style = getComputedStyle(el);
                            if (style.position === 'fixed') return; // ignore fixed overlays
                            const r = el.getBoundingClientRect();
                            if (r.height <= 0) return;
                            const relBottom = (r.bottom - panelRect.top) + panel.scrollTop;
                            if (relBottom > 0) {
                                maxBottom = Math.max(maxBottom, relBottom);
                            }
                        });

                        // Final height is bounded only by document height
                        const measured = Math.max(base, Math.min(maxBottom, document.body.scrollHeight));
                        resolve(Math.max(measured, window.innerHeight));
                    });
                }, 100);
            });
        };

        // Measure both panels and use the maximum to ensure full coverage
        console.log('🔄 Starting panel height measurements...');
        const contentPanelHeight = await getPanelHeight(contentPanel);
        const targetPanelHeight = await getPanelHeight(targetPanel);
        const rawContentHeight = Math.max(contentPanelHeight, targetPanelHeight, window.innerHeight);
        const { cssHeight, bitmapHeight, dpr } = this.getSafeHeights(rawContentHeight);
        const contentHeight = rawContentHeight; // use full raw height for container/hitLayer
        this.contentHeight = rawContentHeight;

        console.log('📐 Content Height Calculation:', {
            contentHeight: contentHeight,
            contentPanelHeight: contentPanelHeight,
            targetPanelHeight: targetPanelHeight,
            contentPanelId: contentPanel.id,
            targetPanelId: targetPanel.id,
            windowHeight: window.innerHeight,
            contentPanelExists: !!contentPanel,
            targetPanelExists: !!targetPanel
        });

        // Additional debugging if heights are zero
        if (contentHeight === 0) {
            console.error('⚠️ ZERO HEIGHT DETECTED!', {
                contentPanel: {
                    id: contentPanel.id,
                    scrollHeight: contentPanel.scrollHeight,
                    offsetHeight: contentPanel.offsetHeight,
                    clientHeight: contentPanel.clientHeight,
                    display: window.getComputedStyle(contentPanel).display,
                    visibility: window.getComputedStyle(contentPanel).visibility,
                    children: Array.from(contentPanel.children).length
                },
                targetPanel: {
                    id: targetPanel.id,
                    scrollHeight: targetPanel.scrollHeight,
                    offsetHeight: targetPanel.offsetHeight,
                    clientHeight: targetPanel.clientHeight,
                    display: window.getComputedStyle(targetPanel).display,
                    visibility: window.getComputedStyle(targetPanel).visibility,
                    children: Array.from(targetPanel.children).length
                }
            });
        }

        // Debug overlay layers and z-index issues
        console.log('🔍 OVERLAY LAYER DEBUG:', {
            allOverlays: Array.from(document.querySelectorAll('[class*="overlay"], [class*="chaos"], [style*="position: absolute"], [style*="position: fixed"]')).map(el => ({
                tagName: el.tagName,
                id: el.id,
                className: el.className,
                zIndex: window.getComputedStyle(el).zIndex,
                position: window.getComputedStyle(el).position,
                display: window.getComputedStyle(el).display,
                visibility: window.getComputedStyle(el).visibility,
                backgroundColor: window.getComputedStyle(el).backgroundColor,
                rect: el.getBoundingClientRect()
            })),
            chaosOverlay: this.chaosOverlay ? {
                id: this.chaosOverlay.id,
                className: this.chaosOverlay.className,
                zIndex: window.getComputedStyle(this.chaosOverlay).zIndex,
                position: window.getComputedStyle(this.chaosOverlay).position,
                display: window.getComputedStyle(this.chaosOverlay).display,
                visibility: window.getComputedStyle(this.chaosOverlay).visibility,
                backgroundColor: window.getComputedStyle(this.chaosOverlay).backgroundColor,
                rect: this.chaosOverlay.getBoundingClientRect()
            } : null,
            chaosViewport: this.chaosViewport ? {
                id: this.chaosViewport.id,
                className: this.chaosViewport.className,
                zIndex: window.getComputedStyle(this.chaosViewport).zIndex,
                position: window.getComputedStyle(this.chaosViewport).position,
                display: window.getComputedStyle(this.chaosViewport).display,
                visibility: window.getComputedStyle(this.chaosViewport).visibility,
                backgroundColor: window.getComputedStyle(this.chaosViewport).backgroundColor,
                rect: this.chaosViewport.getBoundingClientRect()
            } : null
        });

        let actualScrollContainer = contentPanel;
        const hasScroll = contentPanel.scrollHeight > contentPanel.clientHeight;
        if (!hasScroll) {
            const scrollableChild = contentPanel.querySelector('[class*="overflow-auto"], [class*="overflow-y-auto"], [class*="overflow-scroll"]');
            if (scrollableChild) {
                actualScrollContainer = scrollableChild;
            }
        }
        this.scrollableContainer = actualScrollContainer;

        this.originalLeftOverflow = leftPanel.style.overflow;
        this.originalRightOverflow = rightPanel.style.overflow;
        this.originalLeftHeight = leftPanel.style.height;
        this.originalRightHeight = rightPanel.style.height;
        this.originalLeftPosition = leftPanel.style.position;
        this.originalRightPosition = rightPanel.style.position;
        this.originalLeftTop = leftPanel.style.top;
        this.originalRightTop = rightPanel.style.top;
        this.originalTargetChildrenOverflow = [];
        this.originalTargetChildrenScrollTop = [];

        leftPanel.style.overflow = (targetPanel === leftPanel) ? 'hidden' : 'auto';
        rightPanel.style.overflow = (targetPanel === rightPanel) ? 'hidden' : 'auto';

        // Store original overflow for scrollable children in target panel
        // Freeze their scroll position while keeping content visible
        const targetScrollableChildren = targetPanel.querySelectorAll('[class*="overflow-auto"], [class*="overflow-y-auto"], [class*="overflow-x-auto"]');
        
        targetScrollableChildren.forEach((child, index) => {
            // Store original values
            this.originalTargetChildrenOverflow[index] = child.style.overflow;
            this.originalTargetChildrenScrollTop[index] = child.scrollTop;
            
            // For target panel, we want content visible but don't want to change scroll
            // Since chaos viewport is fixed on body, we don't actually need to change overflow here
            // Just disable scrolling by setting overflow to hidden (not visible)
            const currentScrollTop = child.scrollTop;
            child.style.overflow = 'hidden';
            
            console.log('🔒 Freezing child scroll:', {
                index,
                currentScrollTop,
                childClass: child.className
            });
        });

        // Store current scroll position before changing overflow
        const targetPanelScrollTop = targetPanel.scrollTop;
        
        targetPanel.style.position = 'sticky';
        targetPanel.style.top = '0';
        targetPanel.style.height = '100vh';
        targetPanel.style.overflow = 'hidden';
        
        // Only reset scroll if it's NOT the panel with visible content we want to preserve
        // On article pages, right panel shows article list - don't scroll it to top
        if (isArticlePage && targetPanel === rightPanel) {
            // Right panel has content to display - preserve its scroll position
            console.log('📌 Preserving right panel scroll position:', targetPanelScrollTop);
            // Note: overflow:hidden removes scrollbar but content should remain at current position
        } else {
            // For other cases, reset to top since it's just the chaos panel
            targetPanel.scrollTop = 0;
            console.log('🔝 Reset target panel scroll to 0');
        }

        if (contentPanel && contentPanel !== targetPanel) {
            contentPanel.style.overflow = 'auto';
        }

        this.originalReadableOverscroll = contentPanel.style.overscrollBehavior;
        this.originalReadableWebkitScroll = contentPanel.style.webkitOverflowScrolling;
        contentPanel.style.overscrollBehavior = 'contain';
