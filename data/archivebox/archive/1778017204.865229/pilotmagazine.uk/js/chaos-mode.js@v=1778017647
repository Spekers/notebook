                            x: sticker.x_position,
                            y: sticker.y_position,
                            size: isMobile ? 65 : 150,
                            index
                        });
                    });
                }
            }

            // Apply dispersion for mobile items on desktop with collision detection
            const placedElements = []; // Track placed elements for collision detection
            const finalElements = elementsToPlace.map(item => {
                // Estimate size for collision tracking
                const elementWidth = item.type === 'comment' ? 15 : (item.type === 'sticker' ? 8 : 10);
                const elementHeight = item.type === 'comment' ? 5 : (item.type === 'sticker' ? 8 : 10);
                
                const dispersed = this.disperseMobileItemsOnDesktop(item, placedElements);
                const wasDispersed = dispersed.x !== item.x || dispersed.y !== item.y;
                
                // Add this element to the placed elements array for future collision checks
                placedElements.push({
                    x: dispersed.x,
                    y: dispersed.y,
                    width: elementWidth,
                    height: elementHeight,
                    type: item.type
                });
                
                if (wasDispersed) {
                    console.log('✨ Dispersed item:', {
                        type: item.type,
                        id: item.data.id,
                        original: { x: item.x, y: item.y },
                        dispersed: { x: dispersed.x, y: dispersed.y }
                    });
