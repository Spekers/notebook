                        width: ${stickerSize};
                        height: auto;
                        pointer-events: none;
                        z-index: 3;
                    `;
                    container.appendChild(img);
                }
            });

            this.elementsLoaded = true;
            console.log('✅ Elements loaded successfully');
        } catch (error) {
            console.error('❌ Failed to load chaos elements:', error);
        }
    }

    getArticleId() {
        const match = window.location.pathname.match(/\/article\/(\d+)/);
        return match ? match[1] : null;
    }

    /**
     * Simple hash function to create consistent but varied values
     * Used for determining comment sizes and other deterministic variations
     */
    hashString(str) {
        let hash = 0;
        if (str.length === 0) return hash;
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash; // Convert to 32bit integer
        }
        return Math.abs(hash);
    }

    handleMobilePanelToggle() {
        const isMobile = window.innerWidth < 1024;
        if (!isMobile || !this.isActive) return;

        const isArticlePage = window.location.pathname.includes('/article/');
        const alpineApp = document.querySelector('[x-data]');

        if (alpineApp && alpineApp._x_dataStack && alpineApp._x_dataStack[0]) {
            const alpineData = alpineApp._x_dataStack[0];

            console.log('📱 Mobile panel toggle detected:', {
                isArticlePage,
                openRightSide: alpineData.openRightSide,
                shouldCloseOnArticle: isArticlePage && alpineData.openRightSide === false,
                shouldCloseOnNonArticle: !isArticlePage && alpineData.openRightSide === true
            });

            // Article page: canvas is on right panel, so close if user switches to left
            if (isArticlePage && alpineData.openRightSide === false) {
                console.log('📱 Closing chaos mode: user switched away from right panel on article page');
                this.closePencil();
            }
            
            // Non-article page: canvas is on left panel, so close if user switches to right
            if (!isArticlePage && alpineData.openRightSide === true) {
                console.log('📱 Closing chaos mode: user switched away from left panel on non-article page');
                this.closePencil();
            }
        }
    }

    ensureConsistentPositioning() {
        if (!this.isActive) return;
        if (this.elementsLoaded) this.loadExistingElements();
    }

    async undo() {
        if (this.undoStack.length === 0) return;
        
        const item = this.undoStack.pop();
        
        try {
            const csrfToken = document.querySelector('meta[name="csrf"]')?.content;
            if (!csrfToken) {
                console.error('No CSRF token found');
                return;
            }

            const endpoint = `/chaos/${item.type}/${item.id}`;
            const response = await fetch(endpoint, {
                method: 'DELETE',
                headers: {
                    'X-CSRF-TOKEN': csrfToken
                }
            });

            if (response.ok) {
                console.log(`↶ Undid ${item.type} #${item.id}`);
                // Reload elements to reflect the deletion
                await this.loadExistingElements();
                this.updateUndoButton();
            } else {
                console.error('Failed to undo:', response.status);
                // Put the item back if deletion failed
                this.undoStack.push(item);
                this.updateUndoButton();
            }
        } catch (error) {
            console.error('Failed to undo:', error);
            // Put the item back if deletion failed
            this.undoStack.push(item);
            this.updateUndoButton();
        }
    }

