    }

    createMobileUndoButton() {
        const isMobile = window.innerWidth < 1024;
        if (!isMobile) return;
        
        // Don't create if already exists
        if (document.getElementById('chaos-undo-mobile')) return;
        
        const undoBtn = document.createElement('div');
        undoBtn.id = 'chaos-undo-mobile';
        undoBtn.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 50px;
            height: 50px;
            background: #E3E3E3;
            border: 2px solid #000;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10003;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        `;
        
        undoBtn.innerHTML = `
            <svg style="width: 28px; height: 28px;" fill="#000" viewBox="0 0 24 24">
                <path d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/>
            </svg>
        `;
        
        undoBtn.addEventListener('click', () => {
            if (window.chaosMode) window.chaosMode.undo();
        });
        
        document.body.appendChild(undoBtn);
        this.updateUndoButton();
    }

    updateUndoButton() {
        const undoButtonDesktop = document.getElementById('chaos-undo-desktop');
        const undoButtonMobile = document.getElementById('chaos-undo-mobile');
        
        const hasItems = this.undoStack.length > 0;
        
        if (undoButtonDesktop) {
            undoButtonDesktop.style.opacity = hasItems ? '1' : '0.3';
            undoButtonDesktop.style.pointerEvents = hasItems ? 'auto' : 'none';
            undoButtonDesktop.style.cursor = hasItems ? 'pointer' : 'default';
        }
        
        if (undoButtonMobile) {
            undoButtonMobile.style.display = hasItems && this.isActive ? 'flex' : 'none';
        }
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
        window.chaosMode = new ChaosMode();
    });
} else {
    window.chaosMode = new ChaosMode();
}