        // Setup resize/scroll handlers to keep viewport aligned
        this._repositionHandlers = [
            ['resize', alignToPanel],
            ['scroll', alignToPanel],
            ['orientationchange', alignToPanel]
        ];
        this._repositionHandlers.forEach(([evt, fn]) => window.addEventListener(evt, fn, { passive: true }));
        
        // Initial alignment - call immediately and also in next frame
        alignToPanel();
        requestAnimationFrame(() => alignToPanel());

        // Height update handler (when content changes)
        const updateHeights = async () => {
            const contentPanelHeight = await getMobilePanelHeight(contentPanel);
            const targetPanelHeight = await getMobilePanelHeight(targetPanel);
            const rawHeight = Math.max(contentPanelHeight, targetPanelHeight, window.innerHeight);
            
            if (!rawHeight || rawHeight < 100) return;
            if (Math.abs(rawHeight - this.contentHeight) < 50) return; // Skip small changes

            console.log('📱 Updating mobile content height:', {
                oldHeight: this.contentHeight,
                newHeight: rawHeight
            });

            this.contentHeight = rawHeight;

            // Update container height
            if (this.chaosContainer) {
                this.chaosContainer.style.height = rawHeight + 'px';
            }

            // Re-tile canvas with new height
            this.createSharedCanvas(rawHeight, contentPanel, this.activePanel?.clientWidth || panelWidth);
            this.redrawCanvas();

            // Update overlays if they exist
            if (this.textOverlay) this.textOverlay.style.height = rawHeight + 'px';
            if (this.stickerOverlay) this.stickerOverlay.style.height = rawHeight + 'px';
        };

        // Observe content panel for size/content changes
        this.resizeObserver = new ResizeObserver(() => requestAnimationFrame(updateHeights));
        this.resizeObserver.observe(contentPanel);

        this.mutationObserver = new MutationObserver(() => requestAnimationFrame(updateHeights));
        this.mutationObserver.observe(contentPanel, { childList: true, subtree: true, attributes: false });
        
        console.log('✅ Mobile Chaos Mode Setup Complete');
        console.log('   Target Panel:', targetPanel.id);
        console.log('   Content Panel:', contentPanel.id);
        console.log('   Content Height:', rawContentHeight);
    }

    setupDrawingMode() {
        // enable events on the full-height layer
        if (!this.chaosContainer || !this.hitLayer || this.tiles.length === 0) return;
        this.hitLayer.style.pointerEvents = 'all';
        // Use a pencil emoji or SVG as cursor
        const pencilCursor = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='black'><path d='M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z'/></svg>`;
        this.hitLayer.style.cursor = `url("${pencilCursor}") 0 24, crosshair`;
        this.hitLayer.style.touchAction = 'none';

        // remove old listeners
        this.hitLayer.removeEventListener('pointerdown', this.boundStartDrawing);
        this.hitLayer.removeEventListener('pointermove', this.boundDraw);
        this.hitLayer.removeEventListener('pointerup', this.boundStopDrawing);
        this.hitLayer.removeEventListener('pointercancel', this.boundStopDrawing);

        // add listeners
        this.hitLayer.addEventListener('pointerdown', this.boundStartDrawing);
        this.hitLayer.addEventListener('pointermove',  this.boundDraw);
        this.hitLayer.addEventListener('pointerup',    this.boundStopDrawing);
        this.hitLayer.addEventListener('pointercancel',this.boundStopDrawing);
    }

    redrawCanvas() {
        if (!this.tiles.length) return;
        const dpr = window.devicePixelRatio || 1;

        // Clear all tiles
        this.tiles.forEach(t => {
            t.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            t.ctx.clearRect(0, 0, t.canvas.width / dpr, t.canvas.height / dpr);
            t.ctx.strokeStyle = this.currentColor;
            t.ctx.lineWidth = (window.innerWidth < 1024) ? 3 : 4;
            t.ctx.lineCap = 'round';
            t.ctx.lineJoin = 'round';
        });

        // Redraw paths into their tiles with smoothing
        this.drawingPaths.forEach(path => {
            if (path.length < 2) return;
            // Start segment
            for (let i = 1; i < path.length - 1; i++) {
                const prev = path[i - 1];
                const curr = path[i];
                const next = path[i + 1];
                const tileIdx = this._getTileIndexForY(curr.y);
                const tile = this.tiles[tileIdx];
                if (!tile) continue;
                const ctx = tile.ctx;
            // Begin a new subpath for each smoothed segment to avoid long paths accumulating
            ctx.beginPath();
            // If the previous point belongs to another tile, start at current point instead
            const prevTileIdx = this._getTileIndexForY(prev.y);
            if (prevTileIdx !== tileIdx) {
                ctx.moveTo(curr.x, curr.y - tile.top);
            } else {
                ctx.moveTo(prev.x, prev.y - tile.top);
            }
                const midX = (curr.x + next.x) * 0.5;
                const midY = (curr.y + next.y) * 0.5;
                ctx.quadraticCurveTo(curr.x, curr.y - tile.top, midX, midY - tile.top);
                ctx.stroke();
            }
            // Draw last straight segment to the final point for completeness
            const lastIdx = path.length - 1;
            const a = path[lastIdx - 1];
            const b = path[lastIdx];
            const tIdx = this._getTileIndexForY(b.y);
            const t = this.tiles[tIdx];
            if (t) {
                const ctx = t.ctx;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y - t.top);
                ctx.lineTo(b.x, b.y - t.top);
                ctx.stroke();
            }
        });
    }

    startDrawing(e) {
        e.preventDefault();
        
        if (e.pointerId && (this.hitLayer || this.canvas)) {
            try { (this.hitLayer || this.canvas).setPointerCapture(e.pointerId); } catch {}
        }

        this.isDrawing = true;
        this.currentPath = [];
        
        // Cache rect and scroll to avoid repeated expensive calls
        this.cachedRect = (this.chaosViewport || this.activePanel || document.body).getBoundingClientRect();
        this.cachedScrollTop = this.scrollableContainer ? this.scrollableContainer.scrollTop : 0;
        
        const pos = this.getCanvasPosFast(e);
        this.currentPath.push(pos);
        this.lastDrawnPoint = pos;
        
        // Initialize the path on the appropriate tile
            const idx = this._getTileIndexForY(pos.y);
        const tile = this.tiles[idx];
        if (tile) {
            const lineWidth = window.innerWidth < 1024 ? 3 : 4;
            tile.ctx.strokeStyle = this.currentColor;
            tile.ctx.lineWidth = lineWidth;
            tile.ctx.lineCap = 'round';
            tile.ctx.lineJoin = 'round';
            tile.ctx.beginPath();
            tile.ctx.moveTo(pos.x, pos.y - tile.top);
            this.currentTileIdx = idx;
        }
    }

    draw(e) {
        if (!this.isDrawing) return;
        e.preventDefault();

        const pos = this.getCanvasPosFast(e);
        const last = this.lastDrawnPoint;
        
        // Only save points if mouse moved enough
        if (last) {
            const dx = pos.x - last.x;
            const dy = pos.y - last.y;
            const dist2 = dx * dx + dy * dy;
            if (dist2 < 1) return;
        }
        
        // Just collect points - rendering happens on stopDrawing for smoothness
        this.currentPath.push(pos);
        this.lastDrawnPoint = pos;
    }
    
    getCanvasPosFast(e) {
        // Use cached rect to avoid expensive getBoundingClientRect calls
        return {
            x: e.clientX - this.cachedRect.left,
            y: (e.clientY - this.cachedRect.top) + this.cachedScrollTop
        };
    }

    stopDrawing(e) {
        if (!this.isDrawing) return;
        if (e) e.preventDefault();

        if (e && e.pointerId && (this.hitLayer || this.canvas)) {
            try {
                (this.hitLayer || this.canvas).releasePointerCapture(e.pointerId);
            } catch {}
        }

        this.isDrawing = false;
        this.currentTileIdx = undefined;
        this.lastDrawnPoint = null;
        this.cachedRect = null;
        this.drawingScheduled = false;
        this.pendingDrawPoint = null;

        if (this.currentPath.length > 2) {
            // Immediately render smooth preview
            this.renderSmoothPath(this.currentPath);
            
            // Then save to server
            this.drawingPaths.push([...this.currentPath]);
            this.saveDrawing();
        }
        this.currentPath = [];
    }
    
    renderSmoothPath(path) {
        if (path.length < 2) return;
        
        const lineWidth = window.innerWidth < 1024 ? 3 : 4;
        
        // Draw smoothed path across tiles
        for (let i = 1; i < path.length - 1; i++) {
            const prev = path[i - 1];
            const curr = path[i];
            const next = path[i + 1];
            
            const idx = this._getTileIndexForY(curr.y);
            const tile = this.tiles[idx];
            if (!tile) continue;
            
            const ctx = tile.ctx;
            ctx.strokeStyle = this.currentColor;
            ctx.lineWidth = lineWidth;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.beginPath();
            
            const prevIdx = this._getTileIndexForY(prev.y);
            if (prevIdx === idx) {
                ctx.moveTo(prev.x, prev.y - tile.top);
            } else {
                ctx.moveTo(curr.x, curr.y - tile.top);
            }
            
            const midX = (curr.x + next.x) * 0.5;
            const midY = (curr.y + next.y) * 0.5;
            ctx.quadraticCurveTo(curr.x, curr.y - tile.top, midX, midY - tile.top);
            ctx.stroke();
        }
        
        // Draw final segment
        if (path.length >= 2) {
            const a = path[path.length - 2];
            const b = path[path.length - 1];
            const idx = this._getTileIndexForY(b.y);
            const tile = this.tiles[idx];
            if (tile) {
                const ctx = tile.ctx;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y - tile.top);
                ctx.lineTo(b.x, b.y - tile.top);
                ctx.stroke();
            }
        }
    }

    getCanvasPos(e) {
        const rect = (this.chaosViewport || this.activePanel || document.body).getBoundingClientRect();
        const scrollTop = this.scrollableContainer ? this.scrollableContainer.scrollTop : 0;
        return {
            x: e.clientX - rect.left,
            y: (e.clientY - rect.top) + scrollTop
        };
    }

    async saveDrawing() {
        const container = this.chaosContainer || document.querySelector('.chaos-container');

        if (this.currentPath.length === 0) {
            return;
        }

        // Validate canvas dimensions before attempting to save
        if (!this.canvas || this.canvas.width === 0 || this.canvas.height === 0) {
            return;
        }

        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        this.currentPath.forEach(point => {
            minX = Math.min(minX, point.x);
            maxX = Math.max(maxX, point.x);
            minY = Math.min(minY, point.y);
            maxY = Math.max(maxY, point.y);
        });

        const padding = 20;
        minX = Math.max(0, minX - padding);
        minY = Math.max(0, minY - padding);
        maxX = Math.min((this.activePanel?.clientWidth || this.hitLayer?.clientWidth || this.chaosContainer?.clientWidth || window.innerWidth), maxX + padding);
        maxY = Math.min(this.contentHeight, maxY + padding);

        const width = maxX - minX;
        const height = maxY - minY;

        // Scale coordinates by device pixel ratio
        const dpr = window.devicePixelRatio || 1;
        const scaledMinX = minX * dpr;
        const scaledMinY = minY * dpr;
        const scaledWidth = width * dpr;
        const scaledHeight = height * dpr;

        // Build an offscreen canvas of just this stroke from recorded points
        const off = document.createElement('canvas');
        off.width  = Math.min(Math.floor(width  * dpr), ChaosMode.MAX_BITMAP_DIM - ChaosMode.BITMAP_MARGIN);
        off.height = Math.min(Math.floor(height * dpr), ChaosMode.MAX_BITMAP_DIM - ChaosMode.BITMAP_MARGIN);
        const octx = off.getContext('2d');
        octx.setTransform(dpr,0,0,dpr,0,0);
        octx.strokeStyle = this.currentColor;
        octx.lineWidth = (window.innerWidth < 1024) ? 3 : 4;
        octx.lineCap = 'round'; octx.lineJoin = 'round';
        // Draw smoothed path to saved bitmap
        octx.beginPath();
        const p0 = this.currentPath[0];
        octx.moveTo(p0.x - minX, p0.y - minY);
        for (let i = 1; i < this.currentPath.length - 1; i++) {
            const p1 = this.currentPath[i];
            const p2 = this.currentPath[i + 1];
            const midX = (p1.x + p2.x) * 0.5;
            const midY = (p1.y + p2.y) * 0.5;
            octx.quadraticCurveTo(p1.x - minX, p1.y - minY, midX - minX, midY - minY);
        }
        // Final straight segment to the last point
        const last = this.currentPath[this.currentPath.length - 1];
        if (last) {
            octx.lineTo(last.x - minX, last.y - minY);
        }
        octx.stroke();

        const dataURL = off.toDataURL('image/png');

        const centerX = (minX + maxX) / 2;
        const centerY = (minY + maxY) / 2;

        // Use viewport width for consistent positioning across mobile/desktop
        const isMobile = window.innerWidth < 1024;
        const rect = this.chaosViewport ? this.chaosViewport.getBoundingClientRect() : this.activePanel.getBoundingClientRect();
        // Mobile: Use viewport height only for natural placement
        // Desktop: Use full content height for scrollable canvas
        const containerHeight = isMobile ? window.innerHeight : this.contentHeight;
        const containerWidth = rect.width;
        const xPercent = (centerX / containerWidth) * 100;
        const yPercent = (centerY / containerHeight) * 100;

        console.log('✏️ SaveDrawing position:', {
            isMobile,
            center: { x: centerX, y: centerY },
            containerSize: { width: containerWidth, height: containerHeight },
            percent: { x: xPercent, y: yPercent }
        });

        try {
            const csrfToken = document.querySelector('meta[name="csrf"]')?.content;
            if (!csrfToken) {
                return;
            }
            
            // Fire and forget - don't await to avoid blocking
            fetch('/chaos/sketch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrfToken
                },
                body: JSON.stringify({
                    sketch: dataURL,
                    x_position: xPercent,
                    y_position: yPercent,
                    page_url: window.location.pathname,
                    color: this.currentColor,
                    article_id: this.getArticleId(),
                    placed_on_mobile: isMobile
                })
            }).then(async response => {
                if (response.ok) {
                    const data = await response.json();
                    // Add to undo stack
                    if (data.id) {
                        this.undoStack.push({ type: 'sketch', id: data.id });
                        this.updateUndoButton();
                    }
                    this.tiles.forEach(t => t.ctx.clearRect(0, 0, t.canvas.width, t.canvas.height));
                    this.drawingPaths = [];
                    await this.loadExistingElements();
                }
            }).catch(error => {
                // Silently fail to avoid blocking UI
            });

        } catch (error) {
            // Silently fail to avoid blocking UI
        }
    }

    cleanupDrawingMode() {
        // Disable drawing mode on hit layer
        if (this.hitLayer) {
            this.hitLayer.style.cursor = 'default';
            this.hitLayer.style.pointerEvents = 'none';
            
            // Remove drawing event listeners
            this.hitLayer.removeEventListener('pointerdown', this.boundStartDrawing);
            this.hitLayer.removeEventListener('pointermove', this.boundDraw);
            this.hitLayer.removeEventListener('pointerup', this.boundStopDrawing);
            this.hitLayer.removeEventListener('pointercancel', this.boundStopDrawing);
        }
        
        this.isDrawing = false;
        this.currentTileIdx = undefined;
        this.lastDrawnPoint = null;
        this.cachedRect = null;
        this.drawingPaths = [];
    }

    setupTextMode() {
        if (!this.canvas) {
            return;
        }

        // Enable text mode on the hit layer
        if (!this.hitLayer) return;
        // Use a T icon SVG as cursor
        const textCursor = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='black'><path d='M5 4v3h5.5v12h3V7H19V4z'/></svg>`;
        this.hitLayer.style.cursor = `url("${textCursor}") 12 12, text`;
        this.hitLayer.style.pointerEvents = 'all';
        
        // Remove any existing text click handler
        if (this.textClickHandler) {
            this.hitLayer.removeEventListener('click', this.textClickHandler);
        }
        
        // Add text click handler to canvas
        this.textClickHandler = (e) => {
            // Only handle text clicks if we're in text mode and not drawing
            if (this.currentTool === 'text' && !this.isDrawing) {
                this.placeText(e);
            }
        };
        this.hitLayer.addEventListener('click', this.textClickHandler);
    }

    placeText(e) {
        const container = this.chaosContainer || document.querySelector('.chaos-container');
        if (!container) {
            return;
        }
        
        const isMobile = window.innerWidth < 1024;
        const rect = this.chaosViewport ? this.chaosViewport.getBoundingClientRect() : this.activePanel.getBoundingClientRect();
        const scrollTop = this.scrollableContainer ? this.scrollableContainer.scrollTop : 0;

        // Click position relative to the viewport/panel
        const clickX = e.clientX - rect.left;
        const clickY = (e.clientY - rect.top) + scrollTop;

        // Mobile: Use viewport height only for natural placement
        // Desktop: Use full content height for scrollable canvas
        const containerHeight = isMobile ? window.innerHeight : this.contentHeight;
        const containerWidth = rect.width;
        const xPercent = (clickX / containerWidth) * 100;
        const yPercent = (clickY / containerHeight) * 100;

        console.log('📝 PlaceText position:', {
            isMobile,
            clickPos: { x: e.clientX, y: e.clientY },
            rect: { left: rect.left, top: rect.top, width: rect.width },
            clickRelative: { x: clickX, y: clickY },
            containerHeight,
            percent: { x: xPercent, y: yPercent }
        });

        // Variable sizing for desktop - some bigger, some same as before
        let fontSize, maxWidth;
        
        if (isMobile) {
            fontSize = '16px';
            maxWidth = '180px';
        } else {
            // Desktop: Create variety in comment sizes
            // Use a random seed based on current time and position for new comments
            const randomSeed = Date.now() + xPercent + yPercent;
            const sizeVariant = randomSeed % 3; // 0, 1, or 2
            
            switch (sizeVariant) {
                case 0: // Bigger size
                    fontSize = '45px';
                    maxWidth = '500px';
                    break;
                case 1: // Medium size (current)
                    fontSize = '30px';
                    maxWidth = '400px';
                    break;
                case 2: // Smaller size
                    fontSize = '24px';
                    maxWidth = '350px';
                    break;
            }
        }

        // Create container for the comment input (matching search bar design)
        const inputContainer = document.createElement('div');
        
        // Calculate available space to the right of click position
        const minWidth = isMobile ? 180 : 250;
        const padding = 16; // 8px padding on each side
        const availableWidth = containerWidth - clickX;
        const inputWidth = Math.min(maxWidth ? parseInt(maxWidth) : minWidth, availableWidth - padding);
        
        // Position input starting at click point, only extending to the right
        // If there's not enough space, shift it left to fit
        const leftPosition = clickX + inputWidth + padding > containerWidth 
            ? containerWidth - inputWidth - padding 
            : clickX;
        
        inputContainer.style.cssText = `
            position: absolute;
            left: ${leftPosition}px;
            top: ${clickY}px;
            transform: translateY(-50%);
            background: #E3E3E3;
            border: 1px solid black;
            padding: 8px;
            z-index: 1001;
            width: ${inputWidth}px;
            pointer-events: all;
        `;

        const input = document.createElement('input');
        input.type = 'text';
        input.maxLength = 240;
        input.placeholder = 'Brain dump...';

        input.style.cssText = `
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid black;
            font-family: 'Times New Roman', Times, serif;
            color: ${this.currentColor};
            font-size: ${fontSize};
            outline: none;
            padding: 4px 0;
        `;

        // Assemble the comment input
        inputContainer.appendChild(input);

        container.appendChild(inputContainer);
        input.focus();
        
        console.log('📝 Text input created and added to DOM:', {
            inputValue: input.value,
            inputPosition: { x: xPercent + '%', y: yPercent + '%' },
            containerChildren: container.children.length
        });

        let textSaved = false;
        const saveText = async () => {
            if (textSaved) return; // Prevent duplicate saves
            const text = input.value.trim();
            if (text) {
                textSaved = true;
                console.log('💬 Saving comment:', text);
                try {
                    const response = await fetch('/chaos/comment', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf"]').content
                        },
                        body: JSON.stringify({
                            comment: text,
                            x_position: xPercent,
                            y_position: yPercent,
                            page_url: window.location.pathname,
                            color: this.currentColor,
                            article_id: this.getArticleId(),
                            placed_on_mobile: isMobile
                        })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        // Add to undo stack
                        if (data.id) {
                            this.undoStack.push({ type: 'comment', id: data.id });
                            this.updateUndoButton();
                        }
                        await this.loadExistingElements();
                    }

                } catch (error) {
                    console.error('Failed to save comment:', error);
                }
            }
            inputContainer.remove();
        };

        input.addEventListener('blur', saveText);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') saveText();
        });
    }

