/**
 * Saint Andrews Queen Font Handler
 * Detects all-caps text and applies appropriate styling
 * Also randomly styles 2 additional capital letters with Saint Andrews Queen
 */

(function() {
    function isAllCaps(text) {
        // Remove whitespace and check if text has letters
        const trimmed = text.trim();
        const letters = trimmed.replace(/[^a-zA-Z]/g, '');
        
        // If no letters, return false
        if (letters.length === 0) return false;
        
        // Check if all letters are uppercase
        return letters === letters.toUpperCase();
    }

    function hasUppercaseFirst(text) {
        // Get the first letter character
        const trimmed = text.trim();
        const firstLetter = trimmed.match(/[a-zA-Z]/);
        
        if (!firstLetter) return false;
        
        // Check if first letter is uppercase
        return firstLetter[0] === firstLetter[0].toUpperCase();
    }

    function applyRandomCapitalStyling(element) {
        // Skip if already processed, is all caps, or has no-saint-andrews class
        if (element.hasAttribute('data-styled') || element.classList.contains('all-caps') || element.classList.contains('no-saint-andrews')) {
            return;
        }
        
        const originalHTML = element.innerHTML;
        const text = element.textContent;
        
        // Find all capital letter positions (excluding the first one)
        const capitalIndices = [];
        let letterCount = 0;
        let foundFirst = false;
        
        for (let i = 0; i < text.length; i++) {
            const char = text[i];
            if (/[A-Z]/.test(char)) {
                if (!foundFirst) {
                    foundFirst = true; // Skip first capital
                } else {
                    capitalIndices.push(letterCount);
                }
                letterCount++;
            } else if (/[a-z]/.test(char)) {
                letterCount++;
            }
        }
        
        // If we have at least 1 more capital (besides the first), pick 1 random one that's not too close
        if (capitalIndices.length >= 1) {
            // Filter out capitals that are too close to the first letter (within first 3 letters)
            const farEnoughIndices = capitalIndices.filter(index => index >= 4);
            
            // If we have capitals far enough away, use those; otherwise use any available
            const availableIndices = farEnoughIndices.length > 0 ? farEnoughIndices : capitalIndices;
            
            // Pick 1 random capital
            const randomIndex = Math.floor(Math.random() * availableIndices.length);
            const selectedIndices = [availableIndices[randomIndex]];
            
            // Build new HTML with styled capital letters
            let newHTML = '';
            let letterIndex = 0;
            let htmlIndex = 0;
            
            while (htmlIndex < originalHTML.length) {
                const char = originalHTML[htmlIndex];
                
                // Check if we're at a tag
                if (char === '<') {
                    // Copy entire tag
                    const tagEnd = originalHTML.indexOf('>', htmlIndex);
                    if (tagEnd === -1) break;
                    newHTML += originalHTML.substring(htmlIndex, tagEnd + 1);
                    htmlIndex = tagEnd + 1;
                    continue;
                }
                
                // Check if this is a letter character
                if (/[a-zA-Z]/.test(char)) {
                    // Check if this is one of our selected positions and is uppercase
                    if (/[A-Z]/.test(char) && selectedIndices.includes(letterIndex)) {
                        newHTML += `<span class="saint-andrews-cap">${char}</span>`;
                    } else {
                        newHTML += char;
                    }
                    letterIndex++;
                } else {
                    newHTML += char;
                }
                
                htmlIndex++;
            }
            
            element.innerHTML = newHTML;
            element.setAttribute('data-styled', 'true');
        } else {
            // Even if we don't have capitals to style, mark as processed so it becomes visible
            element.setAttribute('data-styled', 'true');
        }
    }

    function applyFontStyling() {
        // Get all heading elements and elements with font-averia class
        const elements = document.querySelectorAll('h1, h2, h3, h4, h5, h6, .font-averia');
        
        elements.forEach(element => {
            // Skip elements with no-saint-andrews class
            if (element.classList.contains('no-saint-andrews')) {
                element.setAttribute('data-styled', 'true');
                return;
            }
            
            const text = element.textContent;
            
            // Check if all caps
            if (isAllCaps(text)) {
                element.classList.add('all-caps');
                element.classList.remove('has-uppercase-first');
                // Mark as processed so it becomes visible
                if (!element.hasAttribute('data-styled')) {
                    element.setAttribute('data-styled', 'true');
                }
            } else {
                element.classList.remove('all-caps');
                
                // Check if first letter is uppercase
                if (hasUppercaseFirst(text)) {
                    element.classList.add('has-uppercase-first');
                    // Mark as processed so it becomes visible
                    if (!element.hasAttribute('data-styled')) {
                        element.setAttribute('data-styled', 'true');
                    }
                } else {
                    element.classList.remove('has-uppercase-first');
                    // Mark as processed so it becomes visible
                    if (!element.hasAttribute('data-styled')) {
                        element.setAttribute('data-styled', 'true');
                    }
                }
                
                // Apply random capital letter styling (this also marks as data-styled)
                applyRandomCapitalStyling(element);
            }
        });
    }

    // Apply on DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyFontStyling);
    } else {
        // DOM is already loaded
        applyFontStyling();
    }

    // Use MutationObserver to style elements as soon as they're added to the DOM
    // This prevents FOUC by styling elements immediately when they appear
    if (typeof MutationObserver !== 'undefined') {
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.addedNodes.length > 0) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) { // Element node
                            // Check if the added node itself is a heading
                            if (node.matches && node.matches('h1, h2, h3, h4, h5, h6, .font-averia')) {
                                styleElement(node);
                            }
                            // Check children
                            const headings = node.querySelectorAll ? node.querySelectorAll('h1, h2, h3, h4, h5, h6, .font-averia') : [];
                            headings.forEach(styleElement);
                        }
                    });
                }
            });
        });

        // Start observing before DOM is ready
        if (document.body) {
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        } else {
            // If body doesn't exist yet, wait for it
            const bodyObserver = new MutationObserver(function() {
                if (document.body) {
                    bodyObserver.disconnect();
                    observer.observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                }
            });
            bodyObserver.observe(document.documentElement, {
                childList: true
            });
        }
    }
    
    // Helper function to style a single element
    function styleElement(element) {
        if (element.hasAttribute('data-styled')) return;
        
        // Skip elements with no-saint-andrews class
        if (element.classList.contains('no-saint-andrews')) {
            element.setAttribute('data-styled', 'true');
            return;
        }
        
        const text = element.textContent;
        
        // Check if all caps
        if (isAllCaps(text)) {
            element.classList.add('all-caps');
            element.classList.remove('has-uppercase-first');
            element.setAttribute('data-styled', 'true');
        } else {
            element.classList.remove('all-caps');
            
            // Check if first letter is uppercase
            if (hasUppercaseFirst(text)) {
                element.classList.add('has-uppercase-first');
            } else {
                element.classList.remove('has-uppercase-first');
            }
            
            // Apply random capital letter styling
            applyRandomCapitalStyling(element);
            
            // Mark as styled if not already marked by applyRandomCapitalStyling
            if (!element.hasAttribute('data-styled')) {
                element.setAttribute('data-styled', 'true');
            }
        }
    }

    // For Livewire page transitions
    document.addEventListener('livewire:navigated', applyFontStyling);
    
    // For Alpine.js transitions
    document.addEventListener('alpine:initialized', applyFontStyling);
})();

