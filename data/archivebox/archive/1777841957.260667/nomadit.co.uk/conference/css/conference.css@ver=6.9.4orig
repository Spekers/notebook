}

#days-container .tt-scroll-indicator {
  position: absolute;
  left: 90%;
  top: 1.5em;
  border-left: 1em solid #aaa;
  border-top: 1em solid transparent;
  border-right: 1em solid transparent;
  border-bottom: 1em solid transparent;
  display: none;
}

