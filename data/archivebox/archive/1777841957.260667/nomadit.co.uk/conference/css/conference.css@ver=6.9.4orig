  left: 16em;
}
.share-buttons.in a.share-button:nth-child(5), body.no-js .share-buttons:hover a.share-button:nth-child(5) {
  left: 20em;
}

a.share-button {
  background-size: 3.3em;
  background-position: -0.1em -0.25em;
